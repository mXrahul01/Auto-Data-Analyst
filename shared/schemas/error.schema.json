{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "request_id",
    "retryable"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "retryable": {
      "type": "boolean"
    },
    "field_errors": {
      "type": "object"
    }
  }
}
